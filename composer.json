{
    "name": "r2soft/r2database",
    "description": "R2 Soft - Repository pattern library based in Laravel",
    "license": "MIT",
    "keywords": [
        "laravel",
        "repository",
        "criteria"
    ],
    "authors": [
        {
            "name": "Ricardo de Paula Coelho",
            "email": "ricardo@r2soft.com.br"
        },
        {
            "name": "R2 Soft - Informática e Softwares Ltda-ME",
            "email": "r2soft@r2soft.com.br"
        }
    ],
    "homepage": "https://www.r2soft.com.br/",
    "require": {
        "php": ">=8.1",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "R2Soft\\R2Database\\": "src/R2Database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "R2Soft\\R2Database\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/resources/stub",
            "tests/resources/migrations"
        ]
    }
}
