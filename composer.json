{
    "name": "r2soft/r2database",
    "description": "Estrutura base para trabalhar com repository pattern",
    "require": {
        "php": ">=8.1",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "R2Soft\\R2Database\\": "src/R2Database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "R2Soft\\R2Database\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/resources/stub",
            "tests/resources/migrations"
        ]
    }
}
