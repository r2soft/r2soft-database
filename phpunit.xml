<?xml version="1.0" encoding="UTF-8" ?>
<phpunit
        backupGlobals="false"
        colors="true"
        processIsolation="true"
        stopOnFailure="false"
>
    <testsuites>
        <testsuite name="Package Test Suite">
            <directory suffix=".php">./tests</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory suffix=".php">src/resources</directory>
        </exclude>
    </coverage>
</phpunit>
